{
  "manifest_version": 3,
  "name": "English Garden Translator",
  "version": "0.1.6",
  "description": "Translate selected English text and save it to your local English Garden.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "English Garden"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Translate selected text"
    }
  },
  "version_name": "0.1.6 · tab-scroll-memory"
}
